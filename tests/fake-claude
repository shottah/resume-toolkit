#!/usr/bin/env bash
# Stand-in for the `claude` CLI, used by tests/run.sh.
# Records its arguments and prompt, then fakes what the real CLI would write.
#   FAKE_LOG     directory for "args" (one argument per line) and "prompt"
#   FAKE_DIR     scaffold mode: create this application folder and print its path
#   FAKE_FIT     fit_score written to notes.md in scaffold mode (default 8)
#   FAKE_OUTPUT  tailor mode: write a minimal .tex file to this path
#                (when unset, the path after "to:" in a tailoring prompt is used)
#   FAKE_CHATTER tailor mode: text to print on stdout, like the real CLI's final message
#   FAKE_FAIL    exit with this code after recording the call
#   FAKE_REPLY   re-check mode: print this instead of a well-formed fit result
set -euo pipefail

log="${FAKE_LOG:?FAKE_LOG must be set}"
mkdir -p "$log"
: > "$log/args"
prompt=""
while [ $# -gt 0 ]; do
  printf '%s\n' "$1" >> "$log/args"
  if [ "$1" = "-p" ] && [ $# -gt 1 ]; then
    prompt="$2"
    printf '%s\n' "$2" >> "$log/args"
    shift
  fi
  shift
done
printf '%s' "$prompt" > "$log/prompt"
[ -n "${FAKE_FAIL:-}" ] && exit "$FAKE_FAIL"

case "$prompt" in
  Scaffold*) mode=scaffold ;;
  Re-score*) mode=recheck ;;
  *"You are tailoring"*) mode=tailor ;;
  *) mode=other ;;
esac

if [ "$mode" = scaffold ] && [ -n "${FAKE_DIR:-}" ]; then
  mkdir -p "$FAKE_DIR"
  printf 'Fake job description.\n' > "$FAKE_DIR/job-description.md"
  cat > "$FAKE_DIR/notes.md" <<NOTES
---
stage: fit_checked
outcome: open
applied_date: ""
company: "Fake Co"
role: "Fake Role"
url: ""
contacts: []
fit_score: ${FAKE_FIT:-8}
fit_gaps: [Fake gap]
fit_minor_gaps: []
fit_confidence: high
---

## Notes
NOTES
  printf '%s\n' "$FAKE_DIR"
fi

if [ "$mode" = tailor ]; then
  output="${FAKE_OUTPUT:-$(printf '%s\n' "$prompt" | sed -n '/^Write a tailored/{n;s/^ *//;p;}')}"
  printf '%s\n' '\documentclass{article}\begin{document}x\end{document}' > "$output"
fi
if [ "$mode" = recheck ]; then
  if [ -n "${FAKE_REPLY:-}" ]; then
    printf '%s\n' "$FAKE_REPLY"
  else
    printf 'fit_score: %s\nfit_gaps: ["Fake gap"]\nfit_minor_gaps: []\nfit_confidence: high\n' "${FAKE_FIT:-8}"
  fi
fi

if [ "$mode" = tailor ] && [ -n "${FAKE_CHATTER:-}" ]; then
  printf '%s\n' "$FAKE_CHATTER"
fi
exit 0
